# API/runtime connection for the separate working PostgreSQL VM.
# Do not commit a real password. Copy this file to .env on the target runtime host.
# If API runs directly on Ubuntu crm-sql, keep 127.0.0.1.
# If API runs from another host, use 192.168.0.166 instead.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=crm_hub
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=replace_with_real_crm_admin_password

DATABASE_URL=postgresql://crm_admin:replace_with_real_crm_admin_password@127.0.0.1:5432/crm_hub?schema=core

REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
API_PORT=3000
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
INTEGRATION_WORKER_ENABLED=true
INTEGRATION_WORKER_INTERVAL_MS=10000
