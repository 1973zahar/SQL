generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "integration"]
}

enum SalesChannel {
  marketplace
  website
  b2b
  retail
  one_c

  @@map("module_code")
  @@schema("core")
}

enum OrderStatus {
  draft
  new_order @map("new")
  confirmed
  paid
  packed
  shipped
  completed
  cancelled
  returned

  @@map("order_status")
  @@schema("core")
}

enum IntegrationEventStatus {
  pending
  processing
  processed
  failed
  ignored

  @@map("event_status")
  @@schema("integration")
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  sourceModule   SalesChannel  @map("source_module")
  externalId     String?       @map("external_id")
  fullName       String        @map("full_name")
  phone          String?
  email          String?
  taxId          String?       @map("tax_id")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  orders         Order[]

  @@unique([sourceModule, externalId])
  @@map("customers")
  @@schema("core")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  sku         String      @unique
  barcode     String?
  name        String
  description String?
  unit        String      @default("pcs")
  isActive    Boolean     @default(true) @map("is_active")
  oneCRef     String?     @unique @map("one_c_ref")
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  orderItems  OrderItem[]

  @@map("products")
  @@schema("core")
}

model Order {
  id              String       @id @default(uuid()) @db.Uuid
  sourceModule    SalesChannel @map("source_module")
  externalId      String?      @map("external_id")
  customerId      String?      @map("customer_id") @db.Uuid
  status          OrderStatus  @default(new_order)
  currency        String       @default("UAH") @db.Char(3)
  totalAmount     Decimal      @default(0) @map("total_amount") @db.Decimal(14, 2)
  shippingAddress String?      @map("shipping_address")
  paymentMethod   String?      @map("payment_method")
  deliveryMethod  String?      @map("delivery_method")
  oneCDocumentRef String?      @map("one_c_document_ref")
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  customer        Customer?    @relation(fields: [customerId], references: [id])
  items           OrderItem[]

  @@unique([sourceModule, externalId])
  @@map("orders")
  @@schema("core")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  skuSnapshot  String   @map("sku_snapshot")
  nameSnapshot String   @map("name_snapshot")
  quantity     Decimal  @db.Decimal(14, 3)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(14, 2)
  order        Order    @relation(fields: [orderId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
  @@schema("core")
}

model InboxEvent {
  id                  String                 @id @default(uuid()) @db.Uuid
  sourceModule        SalesChannel           @map("source_module")
  eventType           String                 @map("event_type")
  externalEventId     String?                @map("external_event_id")
  aggregateType       String                 @map("aggregate_type")
  aggregateExternalId String?                @map("aggregate_external_id")
  payload             Json
  status              IntegrationEventStatus @default(pending)
  errorMessage        String?                @map("error_message")
  receivedAt          DateTime               @default(now()) @map("received_at")
  processedAt         DateTime?              @map("processed_at")

  @@unique([sourceModule, externalEventId])
  @@map("inbox_events")
  @@schema("integration")
}

model OutboxEvent {
  id            String                 @id @default(uuid()) @db.Uuid
  targetModule  SalesChannel           @map("target_module")
  eventType     String                 @map("event_type")
  aggregateType String                 @map("aggregate_type")
  aggregateId   String?                @map("aggregate_id") @db.Uuid
  payload       Json
  status        IntegrationEventStatus @default(pending)
  errorMessage  String?                @map("error_message")
  createdAt     DateTime               @default(now()) @map("created_at")
  processedAt   DateTime?              @map("processed_at")

  @@map("outbox_events")
  @@schema("integration")
}
